# ==============================================================================
# Dorm Trading Platform — Cấu Hình Biến Môi Trường (Environment Configuration)
# Sao chép file này thành .env trên máy local và điều chỉnh thông số nếu cần.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# Cổng mặc định chuẩn là 5432. Nếu máy local bị trùng cổng, đổi thành 5433 trong .env
# ------------------------------------------------------------------------------
POSTGRES_DB=dorm_trading
POSTGRES_USER=dorm_user
POSTGRES_PASSWORD=dorm_password
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dorm_trading

# ------------------------------------------------------------------------------
# 2. Maildev (Giả lập SMTP gửi OTP qua email: UC-01, UC-04, UC-06)
# ------------------------------------------------------------------------------
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# ------------------------------------------------------------------------------
# 3. MinIO Object Storage (S3-compatible)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=dorm_minio_admin
MINIO_ROOT_PASSWORD=dorm_minio_password123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dorm_minio_admin
S3_SECRET_KEY=dorm_minio_password123
S3_REGION=us-east-1
S3_BUCKET_STUDENT_CARDS=student-cards
S3_BUCKET_ITEM_IMAGES=item-images
S3_BUCKET_HANDOVER_PROOFS=handover-proofs

# ------------------------------------------------------------------------------
# 4. Backend Spring Boot Application Configuration
# Lưu ý: Cổng đặt là 8082 để tránh xung đột với cổng 8080 (AgentService / Jenkins)
# và cổng 8081 (React Native Expo Metro Bundler).
# ------------------------------------------------------------------------------
SERVER_PORT=8082
JWT_SECRET=
# Generate a random Base64 key of at least 32 bytes; no default signing key.

# ------------------------------------------------------------------------------
# 5. Cấu hình API Endpoint cho Client (Mobile & Admin Web)
# Chú ý:
# - Android Emulator truy cập host machine qua: http://10.0.2.2:8082/api/v1
# - iOS Simulator truy cập host machine qua:     http://localhost:8082/api/v1
# - Thiết bị thật (Expo Go qua LAN Wi-Fi):       http://<IP_LAN_MAY_BAN>:8082/api/v1 (ví dụ http://192.168.1.15:8082/api/v1)
# - Admin Web (Vite):                           http://localhost:8082/api/v1
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL_EMULATOR=http://10.0.2.2:8082/api/v1
EXPO_PUBLIC_API_URL_SIMULATOR=http://localhost:8082/api/v1
EXPO_PUBLIC_API_URL_LAN=http://192.168.1.100:8082/api/v1
VITE_API_BASE_URL=http://localhost:8082/api/v1
