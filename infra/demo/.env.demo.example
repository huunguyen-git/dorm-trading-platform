# ==============================================================================
# Dorm Trading Platform — Biến môi trường cho gói Demo CD độc lập
# Sao chép file này thành .env (cùng thư mục infra/demo/) trước khi chạy Compose:
#   cp .env.demo.example .env
# ==============================================================================

# 1. Docker Hub Registry & Phiên bản ảnh
# Thay bằng tên tài khoản Docker Hub đã cấu hình trong GitHub Secret DOCKERHUB_USERNAME
DOCKERHUB_USERNAME=your-dockerhub-username
# Dùng `latest` cho bản mới nhất, hoặc đổi sang `sha-<7-ký-tự>` để rollback tức thì
IMAGE_TAG=latest

# 2. Cổng mở trên máy Demo
# LƯU Ý: Mở Admin Web qua http://localhost:8080 (không dùng 127.0.0.1 hay IP LAN không HTTPS)
# vì trình duyệt chỉ chấp nhận cookie refresh `Secure; HttpOnly; SameSite=Strict` trên localhost/HTTPS.
ADMIN_WEB_PORT=8080
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_PORT=1025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 3. Bảo mật Backend (BẮT BUỘC — Backend không có JWT_SECRET fallback)
# Khóa Base64 sau giải mã phải >= 32 bytes. Không lưu sẵn khóa trong Git!
# Tạo khóa ngẫu nhiên trước khi chạy:
# - Linux/macOS/Git Bash: openssl rand -base64 48
# - Windows PowerShell:   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=

# Cho phép origin của Admin Web đi qua Nginx reverse-proxy (cần khớp cổng ADMIN_WEB_PORT)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# 4. Cơ sở dữ liệu PostgreSQL 16 (nội bộ Docker network)
POSTGRES_DB=dorm_trading
POSTGRES_USER=dorm_user
POSTGRES_PASSWORD=dorm_password

# 5. Lưu trữ ảnh MinIO (S3-compatible)
S3_ACCESS_KEY=dorm_minio_admin
S3_SECRET_KEY=dorm_minio_password123
