# Cấu hình API Backend cho ứng dụng di động (chọn đúng 1 dòng theo thiết bị bạn đang test):
# 1. Thiết bị thật iOS / Android (Expo Go chung Wi-Fi/LAN) hoặc LDPlayer:
#    EXPO_PUBLIC_API_URL=http://<IP_LAN_MAY_CHAY_BACKEND>:8082/api/v1
# 2. Android Studio Emulator chuẩn:
#    EXPO_PUBLIC_API_URL=http://10.0.2.2:8082/api/v1
# 3. iOS Simulator trên macOS:
#    EXPO_PUBLIC_API_URL=http://localhost:8082/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8082/api/v1
